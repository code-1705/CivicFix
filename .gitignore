# Root .gitignore for CivicFix

# Environment variables & secrets
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/

# Node & Next.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
**/.next/
out/
build/
.vercel

# Uploads & Media (zero mock images, user media stays in S3 / disk)
backend/uploads/*
!backend/uploads/.gitkeep

# IDEs & System
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
